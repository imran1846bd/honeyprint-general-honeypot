# HoneyPrint | Essential common settings
# Restart ./run.sh after edits. Values are literal; use separate comment lines.
# Platform-specific settings: configs/platforms/<selected-platform>.yaml.
# Queue, batch sizes and timeouts use built-in defaults.
# Default databases: <runtime>/events.sqlite3 and <runtime>/analysis.sqlite3.
# Native platform logs may also exist in platform-owned locations.

# =========================================================
# 1. SETUP
# =========================================================

# Select octoprint | klipper | custom. Default: octoprint
HONEYPRINT_PLATFORM=octoprint

# Public honeypot HTTP port. Default: 8081
HONEYPRINT_PORT=8081

# Optional simulated SSH command service; separate from the HTTP port.
# 127.0.0.1 accepts local connections; 0.0.0.0 listens on all interfaces.
# SSH commands are emulated and recorded in the shared event database.
HONEYPRINT_SSH_ENABLED=false
HONEYPRINT_SSH_HOST=127.0.0.1
HONEYPRINT_SSH_PORT=2222
HONEYPRINT_SSH_USERNAME=admin
HONEYPRINT_SSH_PASSWORD=admin

# Optional simulated Telnet console on a separate port. Telnet is cleartext.
# Keep HOST=127.0.0.1 unless you intentionally expose it to a test network.
HONEYPRINT_TELNET_ENABLED=false
HONEYPRINT_TELNET_HOST=127.0.0.1
HONEYPRINT_TELNET_PORT=2323
HONEYPRINT_TELNET_USERNAME=admin
HONEYPRINT_TELNET_PASSWORD=admin

# Optional local MQTT 3.1.1 simulated printer broker; separate from HTTP.
# Set ENABLED=true to start. Use a test network before binding 0.0.0.0.
HONEYPRINT_MQTT_ENABLED=false
HONEYPRINT_MQTT_HOST=127.0.0.1
HONEYPRINT_MQTT_PORT=1883
HONEYPRINT_MQTT_USERNAME=admin
HONEYPRINT_MQTT_PASSWORD=admin

# 0 = run until stopped; otherwise seconds after readiness. Default: 0
HONEYPRINT_RUN_DURATION_SECONDS=0

# =========================================================
# 2. LOGS AND DATABASE LOCATION
# =========================================================

# Runtime/evidence root: absolute path or path relative to this .env file.
# Default: .honeyprint/quickstart
HONEYPRINT_RUNTIME_DIR=.honeyprint/quickstart

# Raw event DB filename inside RUNTIME_DIR (not an absolute path).
HONEYPRINT_EVIDENCE_DB_NAME=events.sqlite3

# Analysis DB filename inside RUNTIME_DIR; must differ from the raw event DB.
HONEYPRINT_ANALYSIS_DB_NAME=analysis.sqlite3

# Example root: /Users/macairm3/Desktop/HoneyPrintLogs
# Framework artifacts: <runtime>/artifacts/<instance-id>/.
# Native platform logs may additionally use platform-owned paths.
# Restart after edits. Existing logs/databases are not moved automatically.

# =========================================================
# 3. PRINTER
# =========================================================

# Printer display/profile name; external APIs keep their own identity.
HONEYPRINT_PRINTER_NAME=HoneyPrint Virtual Lab

# Shared printer profile; geometry below overrides profile values. Default: configs/profiles/virtual_lab.yaml
HONEYPRINT_PROFILE=configs/profiles/virtual_lab.yaml

# Build width / X, mm. Default: 220
HONEYPRINT_WIDTH=220

# Build depth / Y, mm. Default: 220
HONEYPRINT_DEPTH=220

# Build height / Z, mm. Default: 250
HONEYPRINT_HEIGHT=250

# Profile nozzle diameter, mm. Default: 0.4
HONEYPRINT_NOZZLE=0.4

# Heated bed available: true | false. Default: true
HONEYPRINT_HEATED_BED=true

# =========================================================
# 4. SAVED FILE LOCATION
# =========================================================
# Folder for G-code files saved by the framework.
# Default location: <runtime>/artifacts/<instance-id>/.

# auto = <runtime>/artifacts; or absolute/path relative to this .env file.
# Each instance has its own subdirectory. Existing files are not moved.
HONEYPRINT_ARTIFACT_DIR=auto

# =========================================================
# 5. EVENT CAPTURE
# =========================================================

# Capture supported HTTP/API observations. Default: true
HONEYPRINT_CAPTURE_REQUESTS=true

# Capture supported printer-command observations. Default: true
HONEYPRINT_CAPTURE_COMMANDS=true

# Capture state/workflow observations; lifecycle evidence is mandatory. Default: true
HONEYPRINT_CAPTURE_STATE_CHANGES=true

# =========================================================
# 6. ANALYSIS
# =========================================================

# Enable analysis independently of dashboard. Default: true
HONEYPRINT_ANALYSIS_ENABLED=true

# =========================================================
# 7. PREHEAT PRESET AND OPTIONAL CAMERA
# =========================================================
# Presets do not heat at startup. Activate through the supported platform action.
# OctoPrint: Temperature preset. Built-in lab: Preheat button or POST /api/preheat.
# Klipper: POST /printer/honeyprint/preheat. No standard external custom API action.
# Hotend range 0..280 C; bed 0..130 C (bed target ignored if heated bed is absent).
HONEYPRINT_PREHEAT_HOTEND_C=200
HONEYPRINT_PREHEAT_BED_C=60

# Enable the supported managed OctoPrint camera; auto preserves existing source video.
# Other backends currently have no framework-managed camera; no camera is created there.
HONEYPRINT_CAMERA_ENABLED=true

# auto, a local video file, or HTTP(S) stream URL. Explicit sources require OctoPrint.
# Local video requires the selected source's camera helper. Stream URLs are display-only.
# When CAMERA_ENABLED=false, keep CAMERA_SOURCE=auto.
HONEYPRINT_CAMERA_SOURCE=auto
