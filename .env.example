# Copy this file to .env. Edit values and run ./run.sh.
# Choose one: octoprint, klipper, custom. Advanced all mode starts multiple services.
HONEYPRINT_PLATFORM=octoprint

# One common honeypot URL for every selected platform: http://127.0.0.1:8081
# HONEYPRINT_PORT and INSTANCE_ID require one platform, not all.
HONEYPRINT_PORT=8081
HONEYPRINT_INSTANCE_ID=
HONEYPRINT_ANALYST_ENABLED=false
HONEYPRINT_DASHBOARD_PORT=8090
HONEYPRINT_RUNTIME_DIR=.honeyprint/quickstart

# Optional profile and geometry overrides. Blank values keep the default profile.
HONEYPRINT_PROFILE=
HONEYPRINT_WIDTH=
HONEYPRINT_DEPTH=
HONEYPRINT_HEIGHT=
HONEYPRINT_NOZZLE=
HONEYPRINT_HEATED_BED=

# Blank interpreter lets bootstrap prepare the pinned OctoPrint runtime.
HONEYPRINT_OCTOPRINT_PYTHON=

# Optional trusted local source folders. Blank uses upstream pinned releases.
# Paths for unselected platforms are ignored. Source and OctoPrint interpreter are exclusive.
HONEYPRINT_OCTOPRINT_SOURCE=
HONEYPRINT_KLIPPER_SOURCE=

# With platform=custom, blank code runs the built-in custom lab.
# For your own trusted Python server, set this to examples/custom_server.py
# or an absolute path to your entry file. It must honor the binding/health contract.
HONEYPRINT_CUSTOM_CODE=

# Or bridge an already running HTTP(S) API; leave CUSTOM_CODE blank.
# Example: http://127.0.0.1:5000 (a base path is supported).
HONEYPRINT_CUSTOM_API_URL=
HONEYPRINT_CUSTOM_PYTHON=
HONEYPRINT_CUSTOM_HEALTH_PATH=/
